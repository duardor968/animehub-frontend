{
  "name": "@animehub/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "test:audit": "node --test scripts/audit-dependencies.test.mjs",
    "contract:verify": "node scripts/verify-contract.mjs",
    "contract:generate": "pnpm contract:verify && openapi-typescript contracts/openapi.json -o src/lib/api/generated.ts && prettier --write src/lib/api/generated.ts",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- src/lib/api/generated.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-query": "5.101.4",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "jdownloader-connect": "1.0.9",
    "lucide-react": "1.31.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "prettier": "3.9.6",
    "openapi-typescript": "7.13.0"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.20.0"
  }
}
