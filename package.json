{
  "name": "@animehub/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "test:audit": "node --test scripts/audit-dependencies.test.mjs",
    "contract:verify": "node scripts/verify-contract.mjs",
    "contract:generate": "pnpm contract:verify && openapi-typescript contracts/openapi.json -o src/lib/api/generated.ts && prettier --write src/lib/api/generated.ts",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- src/lib/api/generated.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "jdownloader-connect": "1.0.9",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-aria": "3.53.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "prettier": "3.9.9",
    "openapi-typescript": "7.13.0"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.10.1"
  }
}
