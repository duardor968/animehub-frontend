{
  "name": "@animehub/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "test:audit": "node --test scripts/audit-dependencies.test.mjs",
    "contract:verify": "node scripts/verify-contract.mjs",
    "contract:generate": "pnpm contract:verify && openapi-typescript contracts/openapi.json -o src/lib/api/generated.ts && prettier --write src/lib/api/generated.ts",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- src/lib/api/generated.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.8",
    "@heroui/styles": "3.2.8",
    "@internationalized/date": "3.12.4",
    "embla-carousel-react": "8.6.0",
    "jdownloader-connect": "1.1.0",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "prettier": "3.10.1",
    "openapi-typescript": "7.13.0"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.23.0"
  }
}
